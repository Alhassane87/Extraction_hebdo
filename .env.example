# Copier ce fichier en .env et renseigner les vraies valeurs (jamais commiter .env)

DHIS2_BASE_URL=https://senegal.dhis2.org/dhis
DHIS2_USER=
DHIS2_PASSWORD=
# true (defaut) : verification SSL stricte. Ne passer a false qu'en dernier
# recours, en connaissance de cause (voir docs/decisions/0001-runner-connectivity.md)
DHIS2_VERIFY_SSL=true
